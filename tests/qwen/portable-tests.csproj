<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$([System.IO.Path]::GetTempPath())qwen-terminal-tests-obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <StartupObject>TerminalTests</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>$([System.IO.Path]::GetTempPath())qwen-terminal-tests-bin/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../scripts/qwen/*.cs" />
    <Compile Include="terminal-tests.cs" />
    <Compile Include="launcher-tests.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
